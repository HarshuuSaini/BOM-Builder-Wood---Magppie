# ─────────────────────────────────────────────────────────────────────────────
# Magppie Carcass BOM Builder — environment configuration
# Copy to `.env.local` (Next.js loads it automatically; it is git-ignored).
# NEVER commit real values. In production set these in the Vercel dashboard
# (Project → Settings → Environment Variables) for the Production environment.
# ─────────────────────────────────────────────────────────────────────────────

# ── ZOHO INVENTORY (India data centre) ───────────────────────────────────────
# The app talks to ONE Zoho organization using a single server-side service
# identity (a refresh token). All app users share this identity.

# Your Zoho Inventory organization id (numeric string).
# Find: Zoho Inventory → Settings → Organization Profile, or GET /api/zoho/status.
# Example shape: 60063687231
ZOHO_ORGANIZATION_ID=your_zoho_organization_id_here

# OAuth client credentials from the Zoho API Console (https://api-console.zoho.in)
# Create a "Self Client" (or Server-based app) in the INDIA console.
ZOHO_CLIENT_ID=1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here

# Long-lived refresh token obtained by exchanging a self-client grant code.
# ~70 chars, begins with 1000. and MUST be issued from the .in (India) DC.
# See docs/INTEGRATIONS.md → "How to obtain a refresh token" for the exact steps.
ZOHO_REFRESH_TOKEN=1000.your_refresh_token_here

# Base URLs — MUST stay on the India DC for this organization.
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.in
ZOHO_INVENTORY_BASE_URL=https://www.zohoapis.in/inventory/v1

# ── OPENAI (AI Copilot chat widget) ──────────────────────────────────────────
# Optional. If absent, the copilot replies with a "not configured" message;
# the rest of the app is unaffected. Used by /api/ai/chat (model: gpt-4o-mini).
OPENAI_API_KEY=sk-your_openai_api_key_here
