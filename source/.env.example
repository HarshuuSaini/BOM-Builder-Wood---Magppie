# Only needed for the Zoho-backed features (Sales Order tab, stock check,
# reorder report). The cabinet builder, BOM tables and CSV export work
# without any of this.

# Live saved costings use browser-local storage; login credentials stay server-side.
USER_LOGIN_REQUIRED=1
# Set the configured primary login's role explicitly. Extra local accounts stay development-only.
USER_LOGIN_ROLE=admin

ZOHO_ORGANIZATION_ID=
ZOHO_CLIENT_ID=

# Optional — defaults shown are the .in datacentre
# ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.in
# ZOHO_INVENTORY_BASE_URL=https://www.zohoapis.in/inventory/v1

# Optional — AI Copilot only

# Cloud costing deployment: apply database/supabase-costings.sql first.
# Do not set these for the localhost SQLite preview.
# NEXT_PUBLIC_COSTING_STORAGE=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=  # Server only, never NEXT_PUBLIC_
# USER_LOGIN_NAME=preview
# USER_LOGIN_PASSWORD=  # Set securely in Vercel, never commit credentials.
# USER_SESSION_SECRET=  # At least 32 random characters.
# USER_ACCOUNTS=        # Private JSON array of {username,password,role}; available in production.
